{
  "name": "syntaxx",
  "displayName": "SyntaxX",
  "description": "SyntaxX -  A gamified developer tool that detects inefficient code, helps programmers write computationally efficient code, and rewards them for optimizing their code.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
  "onCommand:syntaxx.analyzeCode"
],
  "main": "./extension.js",
  "contributes": {
    "commands": [{
      "command": "syntaxx.analyzeCode",
      "title": "SyntaxX: Analyze Code"
    }]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.136.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "eslint": "^10.5.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
